{
    "name": "rector/swiss-knife",
    "description": "Swiss knife in pocket of every upgrade architect",
    "license": "MIT",
    "bin": [
        "bin/swiss-knife"
    ],
    "require": {
        "php": ">=7.4",
        "ext-tokenizer": "*",
        "composer/semver": "^3.5",
        "entropy/entropy": "^0.4.23",
        "nikic/php-parser": "^5.9",
        "symfony/process": "^5.4 || ^6.4 || ^7.0 || ^8.1"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "^2.4",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "shipmonk/dead-code-detector": "^1.4",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symplify/easy-coding-standard": "^13.2",
        "symplify/phpstan-rules": "^14.12",
        "tomasvotruba/class-leak": "^2.1",
        "tracy/tracy": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "Rector\\SwissKnife\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rector\\SwissKnife\\Tests\\": "tests"
        },
        "classmap": [
            "stubs"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform-check": false,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "check-cs": "vendor/bin/ecs check --ansi",
        "fix-cs": "vendor/bin/ecs check --fix --ansi",
        "phpstan": "vendor/bin/phpstan analyse --ansi",
        "rector": "vendor/bin/rector process --ansi"
    }
}
